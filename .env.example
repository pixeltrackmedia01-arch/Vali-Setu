# --- Core -------------------------------------------------------------------
# SQLite for local demo. For PostgreSQL change the provider in prisma/schema.prisma
# and use e.g. postgresql://user:password@host:5432/valisetu
DATABASE_URL="file:./dev.db"

# demo: simulated providers, no real messages. live: real adapters (each must be configured).
APP_MODE="demo"
SESSION_TTL_HOURS="8"
# Shows the quick role switcher on the login page. Ignored when NODE_ENV=production.
ENABLE_DEMO_ROLE_SWITCHER="true"
# Hosted public demo only: keeps the demo password and switcher visible in a production build.
PUBLIC_DEMO="false"
# Password given to every seeded demo account. Demo only; never reuse anywhere.
SEED_DEMO_PASSWORD="ValiSetu@2026"

# --- AI (simplification, extraction, translation) ------------------------------
AI_PROVIDER="demo"            # demo | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
AI_TIMEOUT_MS="30000"
TRANSLATION_PROVIDER="demo"   # demo | ai

# --- Speech --------------------------------------------------------------------
SPEECH_PROVIDER="demo"        # demo | espeak (offline, open source; robotic quality)
ESPEAK_BINARY="espeak-ng"

# --- OCR -----------------------------------------------------------------------
OCR_PROVIDER="none"           # no OCR adapter ships with the prototype

# --- Messaging -----------------------------------------------------------------
MESSAGING_PROVIDER="demo"     # demo | whatsapp | sms | voice
# Real sends also require this explicit switch and an authorised operator confirmation.
LIVE_DISPATCH_ENABLED="false"
WHATSAPP_API_URL=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_DLT_ENTITY_ID=""
VOICE_API_URL=""
VOICE_API_KEY=""
# Shared secret for delivery-status callbacks (HMAC-SHA256 of the raw body).
WEBHOOK_SECRET="change-me-to-a-long-random-string"

# --- Files and retention ------------------------------------------------------
UPLOAD_MAX_BYTES="5242880"
STORAGE_DIR="storage"
DATA_RETENTION_DAYS="365"
